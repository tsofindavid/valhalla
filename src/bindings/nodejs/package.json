{
  "name": "@tsofindavid/valhalla",
  "version": "3.9.0",
  "description": "NodeJs bindings for Valhalla",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "valhalla": "./bin/valhalla-cli.js"
  },
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js",
      "types": "./index.d.ts"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "lib/",
    "bin/",
    "proto/",
    "darwin/",
    "linux/",
    "valhalla_*",
    "README.md"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsofindavid/valhalla.git"
  },
  "author": "Valhalla Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tsofindavid/valhalla/issues"
  },
  "homepage": "https://github.com/tsofindavid/valhalla#readme"
}
